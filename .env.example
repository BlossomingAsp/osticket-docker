# --- MariaDB ---
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=osticket
MARIADB_USER=osticket
MARIADB_PASSWORD=change-me-osticket-password
# Optional container resource limits. docker-compose.yml does NOT set any by
# default (limits that exceed a host's RAM/CPU will stop containers from
# starting). To enable, uncomment the deploy.resources section per service in
# docker-compose.yml, e.g. for a host with >= 8GB RAM:
#   db:        memory 2g, cpus 2.0
#   osticket:  memory 1g, cpus 2.0
#   discord-bot: memory 256m, cpus 0.5
# See README -> "Resource limits" for the exact snippet.

# --- osTicket ---
OSTICKET_VERSION=1.18.4
OSTICKET_HTTP_PORT=8080
# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-* headers
# (reverse-proxy/HTTPS deployments only). Leave empty otherwise.
OSTICKET_TRUSTED_PROXIES=

# --- Auto-setup (set 0 for the manual web wizard) ---
# When 1, the container POSTs the setup wizard on first boot using the
# OSTICKET_* values below. When 0, browse to /setup/ and install manually.
OSTICKET_AUTOINSTALL=0
# The four required auto-setup fields fall back to defaults when left blank:
#   OSTICKET_HELPDESK_NAME -> "Help Desk"
#   OSTICKET_DEFAULT_EMAIL -> "helpdesk@localhost"
#   OSTICKET_ADMIN_EMAIL   -> "admin@localhost"
#   OSTICKET_ADMIN_USERNAME-> "admin1"
# OSTICKET_ADMIN_PASSWORD, when blank, is randomly generated and written to .env.
OSTICKET_HELPDESK_NAME=
OSTICKET_DEFAULT_EMAIL=
OSTICKET_LANG=en_US
# OSTICKET_LANG is also baked into the image at build time: the matching
# language pack (e.g. hu_HU) is downloaded from downloads.osticket.com and
# bundled, and it becomes the enforced system language on every container
# start. en_US ships with osTicket. Changing it requires a rebuild.
OSTICKET_TIMEZONE=UTC
# Public URL of the helpdesk, e.g. https://helpdesk.example.com (no trailing
# slash). Used for the wizard's Helpdesk URL and OAuth redirect URI.
OSTICKET_HELPDESK_URL=

# --- Admin account (created only by auto-setup) ---
# OSTICKET_ADMIN_EMAIL / OSTICKET_ADMIN_USERNAME default to
# "admin@localhost" / "admin1" when left blank (username must not be
# admin/admins/username/osticket; email must differ from OSTICKET_DEFAULT_EMAIL).
OSTICKET_ADMIN_FNAME=Admin
OSTICKET_ADMIN_LNAME=User
OSTICKET_ADMIN_EMAIL=
OSTICKET_ADMIN_USERNAME=
OSTICKET_ADMIN_PASSWORD=

# --- Plugins ---
# Comma-separated plugin names bundled in the image:
#   auth-oauth2 - OAuth2/OIDC sign-in (Pocket ID, Google, Discord)
#   auth-2fa    - Authenticator-app two-factor authentication
OSTICKET_PLUGINS=auth-oauth2,auth-2fa

# --- Pocket ID (OIDC) ---
OSTICKET_OIDC_NAME=Pocket ID
OSTICKET_OIDC_URL=
OSTICKET_OIDC_CLIENT_ID=
OSTICKET_OIDC_CLIENT_SECRET=
# Authentication target: none | agents | users | all
OSTICKET_OIDC_AUTH_TARGET=agents
# Pocket ID userinfo claim used as the osTicket username
OSTICKET_OIDC_ATTR_USERNAME=preferred_username

# --- Google OAuth ---
OSTICKET_GOOGLE_NAME=Google
OSTICKET_GOOGLE_CLIENT_ID=
OSTICKET_GOOGLE_CLIENT_SECRET=
OSTICKET_GOOGLE_AUTH_TARGET=agents

# --- Discord OAuth ---
OSTICKET_DISCORD_NAME=Discord
OSTICKET_DISCORD_CLIENT_ID=
OSTICKET_DISCORD_CLIENT_SECRET=
OSTICKET_DISCORD_AUTH_TARGET=agents

# --- Discord ticket bot (experimental) ---
# Turns Discord messages into osTicket tickets and mirrors ticket status back
# onto the Discord message as reactions. Only starts when the token and channel
# are both set; the bot container exits cleanly otherwise.
# 1. Create a bot: https://discord.com/developers/applications -> New
#    Application -> Bot. Copy the token here.
# 2. Enable "Message Content Intent" under Bot -> Privileged Gateway Intents.
# 3. Invite it (OAuth2 -> URL Generator, scope 'bot') with permissions: Send
#    Messages, Add Reactions, Read Message History, View Channels.
# 4. Copy the target channel's ID (right-click channel -> Copy Channel ID).
OSTICKET_DISCORD_BOT_TOKEN=
OSTICKET_DISCORD_CHANNEL_ID=
# Command word users type to open a ticket (default !ticket):
#   !ticket
#   Name: John Doe
#   Email: john@example.com
#   Phone: 555-1234
#   Channel: email
#   Message: I need help with my account
# name, email and message are required; phone and channel are optional.
OSTICKET_DISCORD_TICKET_COMMAND=!ticket
# osTicket API key used to create tickets (Admin -> Manage -> API Keys -> Add
# New API Key). Set the IP to 172.30.0.10 -- osTicket binds API keys to an
# exact client IP, and the discord-bot service is pinned to that static IP
# (a subnet/CIDR will not authenticate). Enable "Can create tickets".
OSTICKET_DISCORD_API_KEY=
# Help topic id tickets are filed under (Admin -> Manage -> Help Topics).
OSTICKET_TOPIC_ID=1
# osTicket dynamic-form field name for the "Preferred communication channel"
# value. Leave empty to fold the channel into the ticket message body instead.
OSTICKET_DISCORD_CHANNEL_FIELD=
# Seconds between status-change polls.
OSTICKET_DISCORD_POLL_INTERVAL=30
# Minimum seconds between ticket creations per Discord user (spam/DoS guard).
# Set 0 to disable. Reacts with ⏳ and ignores the request while cooling down.
OSTICKET_DISCORD_RATE_LIMIT=300
# Map osTicket status names (case-insensitive) to Discord emojis (JSON).
# Keys must match the status names in YOUR osTicket language, e.g. for hu_HU:
#   {"Megnyit":"🟢","Megoldott":"✅","Lezárt":"✅","Archivált":"📦","Törölt":"🗑️"}
OSTICKET_DISCORD_STATUS_EMOJIS={"open":"🟢","assigned":"🔵","answered":"💬","closed":"✅"}
# Reaction added when a ticket is created but its status has no emoji mapping.
OSTICKET_DISCORD_FALLBACK_EMOJI=📥
# Whether the bot creates a Discord thread for each ticket (1/0).
OSTICKET_DISCORD_THREAD_ENABLED=1
# Prefix for Discord thread names.
OSTICKET_DISCORD_THREAD_PREFIX=ticket-
# JSON map of osTicket staff email → Discord user ID for @mentions in thread replies.
# Example: {"staff@example.com":"123456789012345678"}
OSTICKET_DISCORD_STAFF_MAP=
# Enable assignee notifications on client replies via Discord username matching (1/0).
# Requires Server Members Intent (privileged) in Discord Developer Portal.
# osTicket staff username must match Discord user.name exactly (case-insensitive).
OSTICKET_DISCORD_STAFF_MATCH=0

# --- Optional self-hosted mail server (Stalwart) ---
# Set OSTICKET_MAIL_ENABLED=1 and OSTICKET_MAIL_HOSTNAME to run a Stalwart mail
# server alongside the stack (SMTP + IMAP + built-in spam/DKIM, Let's Encrypt).
# When enabled, ./install.sh and ./update.sh start it via `--profile mail` and
# a cron service polls osTicket's api/cron.php so queued mail is delivered and
# inbound IMAP replies are fetched. Then point osTicket's outbound SMTP and
# inbound mailbox at host `mail` (587 / 993) in the admin panel.
#
# Requirements to actually send/receive mail on the internet:
#   - A domain you control, with an A record for mail.<domain> (DNS-only, not a
#     CDN proxy) and an MX record pointing to it.
#   - A reverse-DNS PTR record for the server's IPv4 address matching mail.<domain>
#     (set in the VPS provider's panel, NOT in DNS). Outbound SMTP is pinned to
#     IPv4 so an IPv6 PTR is never needed.
#   - Outbound AND inbound TCP port 25 open (some VPS providers block outbound 25;
#     request unblocking if so). Plus 465/587/993 and 443 for TLS + the admin UI.
#   - SPF, DKIM (Stalwart generates it) and DMARC records.
#
# Managed in the Stalwart admin UI at https://mail.<domain>/ (or
# http://<host>:8081): add your domain and a mailbox (e.g. support@<domain>).
OSTICKET_MAIL_ENABLED=0
OSTICKET_MAIL_HOSTNAME=
#OSTICKET_MAIL_IMAGE=stalwartlabs/stalwart:v0.16
#OSTICKET_MAIL_PUBLIC_URL=
# Ports (override only on conflicts; 443/8081 must not clash with other services):
#OSTICKET_MAIL_SMTP_PORT=25
#OSTICKET_MAIL_SUBMISSION_PORT=587
#OSTICKET_MAIL_SMTPS_PORT=465
#OSTICKET_MAIL_IMAPS_PORT=993
#OSTICKET_MAIL_TLS_PORT=443
#OSTICKET_MAIL_WEB_PORT=8081
